#!/usr/bin/python3
"""bookomarchy-maintenance: backup / export / import / git-sync / zen-sync.

All state stays inside ~/.config/omarchy/bookomarchy unless the user
passes an explicit import/export path. No network, no secrets.
Zen sync only reads bookmark title/url/folder — never logins/cookies.

Hardening (marketplace security baseline):
- Fixed interpreter (/usr/bin/python3) + clean allowlist env: spawned from
  QML with clearEnvironment + `env -i`. Env scrubbed again here.
- Hard wall-clock timeout per action via SIGALRM.
- State dir opened once per component with O_DIRECTORY|O_NOFOLLOW and the
  verified leaf fd is RETAINED: every bounded read, exclusive temp
  creation, fsync and renameat is dirfd-relative — no path re-resolution
  between check and use (no TOCTOU swap). Unpredictable tmp names protect
  the leaf; parent identity comes from the held fd.
- Leaf dirs mode 0700 + uid-owned (fstat). Backups O_EXCL|O_NOFOLLOW.
- Bounded reads (import/jsonlz4/sqlite/profile), entry counts, field and
  output sizes. Zen profiles constrained inside ~/.config/zen; live
  places.sqlite never opened (temp copy, read-only, short timeout).
"""
import configparser
import csv
import glob
import html as htmlmod
import json
import os
import re
import secrets
import shutil
import signal
import sqlite3
import stat
import subprocess
import sys
import tempfile
from datetime import datetime

TIMEOUTS = {"zen-sync": 90, "import": 60}
DEFAULT_TIMEOUT = 30

MAX_ITEMS = 20000
MAX_OUTPUT = 8 * 1024 * 1024
MAX_IMPORT_FILE = 8 * 1024 * 1024
MAX_JSONLZ4_FILE = 64 * 1024 * 1024
MAX_LZ4_OUTPUT = 256 * 1024 * 1024
MAX_SQLITE_FILE = 256 * 1024 * 1024
MAX_SQLITE_ROWS = 100000
MAX_FF_NODES = 200000
FIELD_LIMITS = {"id": 128, "title": 512, "target": 2048, "type": 32,
                "category": 128, "description": 2048}

SCRUB_ENV = ("LD_PRELOAD", "LD_LIBRARY_PATH", "LD_AUDIT", "PYTHONPATH",
             "PYTHONHOME", "PYTHONSTARTUP", "BASH_ENV", "ENV", "ZDOTDIR",
             "PERL5LIB", "RUBYLIB", "NODE_PATH")

STATE = None
ZEN_BASE = None

BLOCKED_CMD = re.compile(r"(sudo\s|rm\s+-rf|chmod|chown|curl\s.*\|\s*sh|wget\s.*\|\s*sh|mkfs|dd\s+of=)", re.I)
SKIP_SCHEMES = ("place:", "about:", "data:", "chrome:", "resource:",
                "wyciwyg:", "moz-", "view-source:")


def scrub_env():
    for k in SCRUB_ENV:
        os.environ.pop(k, None)


def on_timeout(_signum, _frame):
    print("timed out", file=sys.stderr)
    os._exit(124)


def _leaf_ok(name):
    return bool(name) and "/" not in name and name not in (".", "..") \
        and not name.startswith(".") and len(name) <= 128


class StateFS:
    """Verified state dir held by fd; all state IO dirfd-relative (no TOCTOU)."""

    CHAIN = (".config", "omarchy", "bookomarchy")

    def __init__(self, home):
        base = os.path.realpath(home)
        if not base or not os.path.isdir(base):
            raise RuntimeError("cannot resolve home directory")
        fd = os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            for part in self.CHAIN:
                fd = self._child(fd, part, create=True, close_parent=True,
                                 strict=False)
            self._verify(fd, "state dir", strict=True)
            self.fd = fd
            self.bfd = self._child(fd, "backups", create=True,
                                   close_parent=False, strict=True)
            # Verified identity for git cwd (derived from held fd, resolved once).
            self.path = os.readlink(f"/proc/self/fd/{fd}")
        except BaseException:
            try:
                os.close(fd)
            except OSError:
                pass
            raise

    @staticmethod
    def _verify(fd, what, strict):
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode):
            raise RuntimeError(f"{what} is not a directory")
        if st.st_uid != os.getuid():
            raise RuntimeError(f"{what} not owned by current user")
        if strict and stat.S_IMODE(st.st_mode) & 0o077:
            os.fchmod(fd, 0o700)

    def _child(self, parent_fd, name, create, close_parent, strict):
        if name not in self.CHAIN and name != "backups" and not _leaf_ok(name):
            raise RuntimeError(f"bad name: {name}")
        try:
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                         dir_fd=parent_fd)
        except FileNotFoundError:
            if not create:
                raise
            os.mkdir(name, 0o700, dir_fd=parent_fd)
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                         dir_fd=parent_fd)
        if close_parent:
            try:
                os.close(parent_fd)
            except OSError:
                pass
        self._verify(fd, name, strict)
        return fd

    def read(self, name, limit):
        """Bounded read of a state file, dirfd-relative (no re-resolution)."""
        if not _leaf_ok(name):
            raise RuntimeError(f"bad name: {name}")
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=self.fd)
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
                raise RuntimeError(f"refusing {name}")
            if st.st_size > limit:
                raise RuntimeError(f"{name} exceeds size limit")
            chunks, total = [], 0
            while True:
                b = os.read(fd, 65536)
                if not b:
                    break
                total += len(b)
                if total > limit:
                    raise RuntimeError(f"{name} exceeds size limit")
                chunks.append(b)
            return b"".join(chunks)
        finally:
            os.close(fd)

    def write_atomic(self, name, payload: bytes):
        """Exclusive unpredictable tmp + fsync + renameat + dir fsync."""
        if not _leaf_ok(name):
            raise RuntimeError(f"bad name: {name}")
        if len(payload) > MAX_OUTPUT:
            raise RuntimeError("output exceeds size limit")
        for _ in range(5):
            tmp = f".w-{secrets.token_hex(16)}.tmp"
            try:
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                             | os.O_NOFOLLOW, 0o600, dir_fd=self.fd)
                break
            except FileExistsError:
                continue
        else:
            raise RuntimeError("cannot allocate temp file")
        try:
            view = memoryview(payload)
            while view:
                n = os.write(fd, view)
                view = view[n:]
            os.fsync(fd)
        finally:
            os.close(fd)
        try:
            os.rename(tmp, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=self.fd)
            except OSError:
                pass
            raise
        os.fsync(self.fd)

    def write_backup(self, name, payload: bytes):
        """O_EXCL backup write inside held backups dir (no replace)."""
        if not _leaf_ok(name):
            raise RuntimeError(f"bad name: {name}")
        if len(payload) > MAX_OUTPUT:
            raise RuntimeError("output exceeds size limit")
        fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                     | os.O_NOFOLLOW, 0o600, dir_fd=self.bfd)
        try:
            view = memoryview(payload)
            while view:
                n = os.write(fd, view)
                view = view[n:]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.fsync(self.bfd)


def read_plain_bounded(path, limit):
    """Bounded read of an explicit user-supplied path (import/export target)."""
    st = os.stat(path)
    if not stat.S_ISREG(st.st_mode):
        raise RuntimeError(f"not a regular file: {path}")
    if st.st_size > limit:
        raise RuntimeError("file exceeds size limit")
    with open(path, "rb") as f:
        data = f.read(limit + 1)
    if len(data) > limit:
        raise RuntimeError("file exceeds size limit")
    return data


def read_nofollow_bounded(path, limit):
    """Bounded read refusing symlinks (browser/profile sources)."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise RuntimeError(f"not a regular file: {path}")
        if st.st_size > limit:
            raise RuntimeError("file exceeds size limit")
        chunks, total = [], 0
        while True:
            b = os.read(fd, 65536)
            if not b:
                break
            total += len(b)
            if total > limit:
                raise RuntimeError("file exceeds size limit")
            chunks.append(b)
        return b"".join(chunks)
    finally:
        os.close(fd)


def check_entry(it):
    if not isinstance(it, dict):
        raise RuntimeError("each bookmark must be an object")
    for k in ("id", "title", "target"):
        if not str(it.get(k, "")).strip():
            raise RuntimeError(f"missing required field: {k}")
    for banned in ("password", "token", "private_key", "secret"):
        if banned in it:
            raise RuntimeError(f"refused field: {banned}")
    for field, limit in FIELD_LIMITS.items():
        v = it.get(field)
        if v is not None and len(str(v)) > limit:
            raise RuntimeError(f"field too long: {field}")


# (pattern, category): first match wins. Applied to title+url on zen-sync
# import AND by the `recategorize` command for existing items.
DEFAULT_CATEGORY_RULES = [
    ("hackthebox|tryhackme|hackmyvm|offsec|pwntilldawn|echoctf|vulnlab|"
     "cyberseclabs|cybertalents|portswigger|pentesterlab|blueteam|"
     "letsdefend|cyberdefenders|root-me|overthewire|picoctf|\\bctf\\b",
     "Cybersecurity"),
    ("github|gitlab|stackoverflow|archwiki|hyprland|omarchy", None),  # None = keep folder/default
]


# URLs/titles matching these regexes are never imported by zen-sync.
# Customizable via settings.json -> zenSync.exclude (list of regex strings).
DEFAULT_EXCLUDE = [
    r"support\.mozilla\.org",
    r"mozilla\.org/(contribute|about)",
]


def zen_excluded(title, url):
    patterns = list(DEFAULT_EXCLUDE)
    try:
        zcfg = load_settings().get("zenSync") or {}
        for p in zcfg.get("exclude") or []:
            if isinstance(p, str) and p.strip() and len(p) <= 256:
                patterns.append(p)
    except Exception:
        pass
    hay = f"{title} {url}"[:4096]
    for pattern in patterns:
        try:
            if re.search(pattern, hay, re.I):
                return True
        except re.error:
            continue
    return False


def category_rules():
    extra = []
    try:
        zcfg = load_settings().get("zenSync") or {}
        for r in (zcfg.get("categoryRules") or [])[:32]:
            if isinstance(r, (list, tuple)) and len(r) == 2:
                extra.append((str(r[0])[:256], r[1]))
            elif isinstance(r, dict) and r.get("match"):
                extra.append((str(r["match"])[:256], r.get("category")))
    except Exception:
        pass
    return extra + DEFAULT_CATEGORY_RULES


def rule_category(title, url, fallback):
    hay = f"{title} {url}".lower()[:4096]
    for pattern, cat in category_rules():
        if not cat:
            continue
        try:
            if re.search(pattern, hay, re.I):
                return cat
        except re.error:
            continue
    return fallback


def load():
    try:
        raw = STATE.read("bookmarks.json", MAX_OUTPUT)
    except FileNotFoundError:
        return []
    data = json.loads(raw.decode("utf-8"))
    items = data if isinstance(data, list) else data.get("bookmarks", [])
    if not isinstance(items, list) or len(items) > MAX_ITEMS:
        raise RuntimeError("bookmarks file invalid or too large")
    return items


def save(items):
    if len(items) > MAX_ITEMS:
        raise RuntimeError("too many bookmarks")
    for it in items:
        check_entry(it)
    STATE.write_atomic("bookmarks.json",
                       (json.dumps(items, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))


def load_settings():
    try:
        raw = STATE.read("settings.json", 1024 * 1024)
    except FileNotFoundError:
        return {}
    except Exception:
        return {}
    try:
        s = json.loads(raw.decode("utf-8"))
        return s if isinstance(s, dict) else {}
    except Exception:
        return {}


def save_settings(s):
    STATE.write_atomic("settings.json",
                       (json.dumps(s, ensure_ascii=False, indent=2) + "\n").encode("utf-8"))


def normalize_url(t):
    t = str(t or "").strip()
    if re.match(r"^https?://", t, re.I):
        pass
    elif re.match(r"^[\w-]+(\.[\w-]+)+(/\S*)?$", t):
        t = "https://" + t
    # canonicalize for dedupe: lower host, strip trailing slash, strip utm
    try:
        from urllib.parse import urlsplit, urlunsplit, parse_qsl, urlencode
        parts = urlsplit(t)
        if parts.scheme in ("http", "https"):
            netloc = parts.netloc.lower()
            path = parts.path.rstrip("/") or ""
            q = [(k, v) for k, v in parse_qsl(parts.query, keep_blank_values=True)
                 if not k.lower().startswith("utm_")]
            return urlunsplit((parts.scheme.lower(), netloc, path,
                               urlencode(q), ""))
    except Exception:
        pass
    return t


def slugify(title, existing_ids):
    base = re.sub(r"[^a-z0-9]+", "-", str(title or "bookmark").lower()).strip("-") or "bookmark"
    bid, n = base[:64], 2
    while bid in existing_ids:
        bid = f"{base}-{n}"
        n += 1
        if n > 100000:
            raise RuntimeError("cannot allocate bookmark id")
    return bid


def backup_name():
    stamp = datetime.now().strftime("%Y-%m-%d-%H%M")
    return f"bookomarchy-backup-{stamp}.json"


def cmd_backup(_args):
    data = STATE.read("bookmarks.json", MAX_OUTPUT)
    name = backup_name()
    try:
        STATE.write_backup(name, data)
    except FileExistsError:
        stamp = datetime.now().strftime("%Y-%m-%d-%H%M%S")
        name = f"bookomarchy-backup-{stamp}-{os.getpid()}.json"
        STATE.write_backup(name, data)
    print(os.path.join(STATE.path, "backups", name))


def cmd_export_json(args):
    data = STATE.read("bookmarks.json", MAX_OUTPUT)
    if not args:
        STATE.write_atomic("bookmarks-export.json", data)
        print(os.path.join(STATE.path, "bookmarks-export.json"))
        return
    dest = os.path.expanduser(args[0])
    with open(dest, "wb") as f:  # explicit user target
        f.write(data)
    print(dest)


def cmd_export_html(args):
    items = load()
    parts = ["<!DOCTYPE NETSCAPE-Bookmark-file-1>\n<META HTTP-EQUIV=\"Content-Type\" CONTENT=\"text/html; charset=UTF-8\">\n<TITLE>BookOmarchy</TITLE>\n<H1>BookOmarchy</H1>\n<DL><p>\n"]
    size = len(parts[0])
    for it in items:
        url = htmlmod.escape(str(it.get("target", ""))[:2048], quote=True)
        title = htmlmod.escape(str(it.get("title", ""))[:512])
        parts.append(f'    <DT><A HREF="{url}">{title}</A>\n')
        size += len(parts[-1])
        if size > MAX_OUTPUT:
            raise RuntimeError("export exceeds size limit")
    parts.append("</DL><p>\n")
    payload = "".join(parts).encode("utf-8")
    if not args:
        STATE.write_atomic("bookmarks.html", payload)
        print(os.path.join(STATE.path, "bookmarks.html"))
        return
    dest = os.path.expanduser(args[0])
    with open(dest, "wb") as f:  # explicit user target
        f.write(payload)
    print(dest)


def parse_html(text):
    out = []
    for m in re.finditer(r'<A\s[^>]*HREF="([^"]{1,2048})"[^>]*>([^<]{1,512})</A>', text, re.I):
        url, title = m.group(1).strip(), m.group(2).strip()
        if not url or not title:
            continue
        bid = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:64] or f"import-{len(out)}"
        out.append({"id": bid, "title": title, "type": "url", "target": url,
                    "category": "Imported", "aliases": [], "tags": [], "description": ""})
        if len(out) >= MAX_ITEMS:
            break
    return out


def cmd_import(args):
    if not args:
        print("usage: import <path.json|path.html|path.csv>", file=sys.stderr)
        return 1
    path = os.path.expanduser(args[0])
    raw = read_plain_bounded(path, MAX_IMPORT_FILE).decode("utf-8", errors="replace")
    items = []
    if path.endswith(".html"):
        items = parse_html(raw)
    elif path.endswith(".csv"):
        for row in csv.DictReader(raw.splitlines()):
            title = (row.get("title") or "").strip()[:512]
            target = (row.get("target") or row.get("url") or "").strip()[:2048]
            if not title or not target:
                continue
            bid = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:64]
            items.append({"id": bid or f"import-{len(items)}", "title": title, "type": "url",
                          "target": target, "category": (row.get("category") or "Imported").strip()[:128] or "Imported",
                          "aliases": [], "tags": [], "description": ""})
            if len(items) >= MAX_ITEMS:
                break
    else:
        data = json.loads(raw)
        raw_items = data if isinstance(data, list) else data.get("bookmarks", [])
        if not isinstance(raw_items, list) or len(raw_items) > MAX_ITEMS:
            print("import file invalid or too large", file=sys.stderr)
            return 1
        items = raw_items
    existing = load()
    if len(existing) + len(items) > MAX_ITEMS:
        print("import would exceed bookmark limit", file=sys.stderr)
        return 1
    seen = {str(x.get("id")) for x in existing}
    added = 0
    for it in items:
        if not isinstance(it, dict) or not it.get("id") or not it.get("title") or not it.get("target"):
            continue
        if str(it["id"]) in seen:
            continue
        it.setdefault("type", "url")
        it.setdefault("category", "Imported")
        it.setdefault("aliases", [])
        it.setdefault("tags", [])
        it.setdefault("description", "")
        try:
            check_entry(it)
        except RuntimeError:
            continue
        existing.append(it)
        seen.add(str(it["id"]))
        added += 1
    save(existing)
    print(f"imported {added} of {len(items)}")
    return 0


# ---------------- Zen sync ----------------

def zen_profiles():
    """Return [(name, abspath)] from profiles.ini + any *.Default* dirs as fallback."""
    out = []
    ini = os.path.join(ZEN_BASE, "profiles.ini")
    if os.path.exists(ini):
        cp = configparser.ConfigParser()
        try:
            cp.read_string(read_nofollow_bounded(ini, 1024 * 1024).decode("utf-8", errors="replace"))
            for sec in cp.sections():
                if sec.lower().startswith("profile"):
                    path = (cp[sec].get("Path") or "").strip()
                    is_rel = (cp[sec].get("IsRelative") or "1").strip() == "1"
                    name = (cp[sec].get("Name") or path).strip() or path
                    full = os.path.join(ZEN_BASE, path) if is_rel else path
                    if full and os.path.isdir(full):
                        out.append((name, full))
        except Exception:
            pass
    if not out:
        for d in glob.glob(os.path.join(ZEN_BASE, "*.Default*")):
            if os.path.isdir(d):
                out.append((os.path.basename(d), d))
    return out


def inside_zen_base(path):
    try:
        return os.path.realpath(path).startswith(os.path.realpath(ZEN_BASE) + os.sep)
    except Exception:
        return False


def pick_zen_profile(want):
    profiles = zen_profiles()
    if not profiles:
        return None, None
    if want:
        want = want.lower()
        for name, path in profiles:
            if want in name.lower() or want in os.path.basename(path).lower():
                return name, path
        # treat as direct path, constrained inside the zen base dir
        direct = os.path.expanduser(want)
        if os.path.isdir(direct) and inside_zen_base(direct):
            return os.path.basename(direct), direct
    # prefer profile with biggest places.sqlite
    best, best_sz = profiles[0], -1
    for item in profiles:
        p = os.path.join(item[1], "places.sqlite")
        try:
            sz = os.path.getsize(p)
        except OSError:
            sz = -1
        if sz > best_sz:
            best, best_sz = item, sz
    return best


def lz4_block_decompress(raw, max_out=MAX_LZ4_OUTPUT):
    """Pure-python LZ4 block decompressor (no frame). Raises on corrupt data."""
    n = len(raw)
    pos = 0
    out = bytearray()

    def read_u16(p):
        return raw[p] | (raw[p + 1] << 8)

    while pos < n:
        token = raw[pos]
        pos += 1
        lit_len = token >> 4
        if lit_len == 15:
            while True:
                if pos >= n:
                    raise ValueError("truncated literal length")
                b = raw[pos]
                pos += 1
                lit_len += b
                if b != 255:
                    break
        if pos + lit_len > n:
            raise ValueError("truncated literals")
        if len(out) + lit_len > max_out:
            raise ValueError("decompressed output exceeds limit")
        out.extend(raw[pos:pos + lit_len])
        pos += lit_len
        if pos >= n:
            break  # last literals
        if pos + 2 > n:
            raise ValueError("truncated offset")
        offset = read_u16(pos)
        pos += 2
        if offset == 0 or offset > len(out):
            raise ValueError("bad offset")
        match_len = token & 0xF
        if match_len == 15:
            while True:
                if pos >= n:
                    raise ValueError("truncated match length")
                b = raw[pos]
                pos += 1
                match_len += b
                if b != 255:
                    break
        match_len += 4
        if len(out) + match_len > max_out:
            raise ValueError("decompressed output exceeds limit")
        start = len(out) - offset
        for _ in range(match_len):
            out.append(out[start])
            start += 1
    return bytes(out)


def read_jsonlz4(path):
    data = read_nofollow_bounded(path, MAX_JSONLZ4_FILE)
    if data[:8] != b"mozLz40\0":
        raise ValueError("not mozlz4")
    body = data[8:]
    # Firefox variants: some files prefix the LZ4 block with the
    # 4-byte LE uncompressed size. Try both, prefer lz4 lib when present.
    candidates = [body]
    if len(body) > 4:
        candidates.append(body[4:])
    try:
        import lz4.block as lz4b  # faster when available
        last_err = None
        for c in candidates:
            try:
                raw = lz4b.decompress(c)
                if len(raw) > MAX_LZ4_OUTPUT:
                    raise ValueError("decompressed output exceeds limit")
                return json.loads(raw.decode("utf-8"))
            except Exception as e:
                last_err = e
        raise last_err
    except ImportError:
        last_err = None
        for c in candidates:
            try:
                return json.loads(lz4_block_decompress(c).decode("utf-8"))
            except Exception as e:
                last_err = e
        raise last_err


def walk_ff_bookmarks(node, folder, out, counter):
    """Recursively collect (title, url, folder) from Firefox bookmark JSON."""
    counter[0] += 1
    if counter[0] > MAX_FF_NODES:
        raise ValueError("bookmark tree exceeds node limit")
    if isinstance(node, list):
        for c in node:
            walk_ff_bookmarks(c, folder, out, counter)
        return
    if not isinstance(node, dict):
        return
    ntype = node.get("type") or node.get("typeCode")
    if ntype in ("text/x-moz-place-container", 2):
        title = str(node.get("title") or "").strip()[:128]
        next_folder = folder
        if title and node.get("root") not in ("placesRoot",):
            next_folder = title if folder in ("", "root") else (folder + " / " + title)[:256]
        for c in node.get("children", []) or []:
            walk_ff_bookmarks(c, next_folder, out, counter)
    elif ntype in ("text/x-moz-place", 1):
        url = str(node.get("uri") or "").strip()
        title = (str(node.get("title") or "").strip() or url)[:512]
        if not url or len(url) > 2048 or url.startswith(SKIP_SCHEMES):
            return
        out.append((title, url, folder or "Zen"))
        if len(out) >= MAX_SQLITE_ROWS:
            raise ValueError("bookmark count exceeds limit")
    else:
        for c in node.get("children", []) or []:
            walk_ff_bookmarks(c, folder, out, counter)


def zen_from_backup(profile_path):
    bdir = os.path.join(profile_path, "bookmarkbackups")
    cands = sorted(glob.glob(os.path.join(bdir, "*.jsonlz4")),
                   key=lambda p: os.path.getmtime(p), reverse=True)[:8]
    if not cands:
        return [], None
    latest = cands[0]
    try:
        doc = read_jsonlz4(latest)
    except Exception as e:
        print(f"zen backup unreadable ({e}), trying places.sqlite", file=sys.stderr)
        return [], None
    out = []
    try:
        walk_ff_bookmarks(doc, "", out, [0])
    except Exception as e:
        print(f"zen backup walk failed ({e})", file=sys.stderr)
        return [], None
    return out, latest


def copy_nofollow_bounded(src, dest, limit):
    """Copy a browser source file refusing symlinks, with size cap."""
    fd_in = os.open(src, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        st = os.fstat(fd_in)
        if not stat.S_ISREG(st.st_mode):
            raise RuntimeError(f"not a regular file: {src}")
        if st.st_size > limit:
            raise RuntimeError(f"file exceeds size limit: {src}")
        fd_out = os.open(dest, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            total = 0
            while True:
                b = os.read(fd_in, 65536)
                if not b:
                    break
                total += len(b)
                if total > limit:
                    raise RuntimeError(f"file exceeds size limit: {src}")
                view = memoryview(b)
                while view:
                    n = os.write(fd_out, view)
                    view = view[n:]
            os.fsync(fd_out)
        finally:
            os.close(fd_out)
    finally:
        os.close(fd_in)


def zen_from_sqlite(profile_path):
    src = os.path.join(profile_path, "places.sqlite")
    if not os.path.exists(src):
        return [], None
    # Never touch the live DB: copy sqlite+wal+shm to a private temp dir
    # and read the copy read-only with a short timeout.
    tmpdir = tempfile.mkdtemp(prefix="bookomarchy-zen-")
    try:
        os.chmod(tmpdir, 0o700)
    except OSError:
        pass
    tmp_db = os.path.join(tmpdir, "places.sqlite")
    try:
        for suffix in ("", "-wal", "-shm"):
            p = src + suffix
            if os.path.exists(p):
                try:
                    copy_nofollow_bounded(p, tmp_db + suffix, MAX_SQLITE_FILE)
                except (OSError, RuntimeError) as e:
                    print(f"zen copy failed ({e})", file=sys.stderr)
                    return [], None
        try:
            con = sqlite3.connect(f"file:{tmp_db}?mode=ro", uri=True, timeout=2)
        except Exception as e:
            print(f"zen places.sqlite open failed ({e})", file=sys.stderr)
            return [], None
        try:
            cur = con.cursor()
            cur.execute(
                "SELECT b.title, p.url, COALESCE(f.title,'') "
                "FROM moz_bookmarks b JOIN moz_places p ON b.fk = p.id "
                "LEFT JOIN moz_bookmarks f ON b.parent = f.id "
                "WHERE b.type = 1 AND p.url NOT LIKE 'place:%' "
                f"LIMIT {MAX_SQLITE_ROWS}")
            rows = []
            for (t, u, fl) in cur.fetchall():
                u = (u or "").strip()
                if not u or len(u) > 2048 or u.startswith(SKIP_SCHEMES):
                    continue
                rows.append(((str(t or u).strip() or u)[:512], u,
                             str(fl or "").strip()[:128] or "Zen"))
            return rows, src
        except Exception as e:
            print(f"zen places.sqlite query failed ({e})", file=sys.stderr)
            return [], None
        finally:
            try:
                con.close()
            except Exception:
                pass
    finally:
        try:
            shutil.rmtree(tmpdir, ignore_errors=True)
        except OSError:
            pass


def cmd_zen_sync(args):
    want_profile = None
    category_override = None
    dry_run = False
    for a in args:
        if a == "--dry-run":
            dry_run = True
        elif a.startswith("--profile="):
            want_profile = a.split("=", 1)[1][:128]
        elif a.startswith("--category="):
            category_override = a.split("=", 1)[1][:128]
        elif a.startswith("--"):
            print(f"unknown flag: {a}", file=sys.stderr)
            return 2
        elif want_profile is None:
            want_profile = a[:128]
    name, path = pick_zen_profile(want_profile)
    if not path:
        print("zen profile not found (~/.config/zen)", file=sys.stderr)
        return 1
    # Query BOTH sources (backup is lock-free but can be stale; sqlite copy
    # is live) and union by normalized URL — live sqlite wins on conflicts.
    b_items, b_src = zen_from_backup(path)
    s_items, s_src = zen_from_sqlite(path)
    merged = {}
    for title, url, folder in b_items + s_items:
        key = normalize_url(url).lower()
        if not key or key in merged or zen_excluded(title, url):
            continue
        merged[key] = (title, url, folder)
    # prefer live sqlite titles when the same URL exists in both
    for title, url, folder in s_items:
        key = normalize_url(url).lower()
        if key in merged and not zen_excluded(title, url):
            merged[key] = (title, url, folder)
    items = list(merged.values())
    source = s_src or b_src
    if not items and not source:
        print("no zen bookmarks source (backup + places.sqlite unavailable)", file=sys.stderr)
        return 1
    settings = load_settings()
    zcfg = settings.get("zenSync") if isinstance(settings.get("zenSync"), dict) else {}
    default_cat = category_override or (zcfg.get("category") if isinstance(zcfg, dict) else None) or "Zen"

    existing = load()
    seen_url = {}
    for x in existing:
        if str(x.get("type", "url")) == "url":
            seen_url[normalize_url(x.get("target", "")).lower()] = x
    ids = {str(x.get("id")) for x in existing}
    fresh = []
    for title, url, folder in items:
        norm = normalize_url(url)
        if not norm or norm.lower() in seen_url:
            continue  # keep user's title/meta — never overwrite
        bid = slugify(title, ids)
        ids.add(bid)
        cat = default_cat if folder in ("", "root") else folder
        cat = rule_category(title, norm, cat)
        fresh.append({"id": bid, "title": title[:512], "type": "url", "target": norm[:2048],
                      "category": cat[:128], "aliases": [], "tags": ["zen"],
                      "description": f"Zen import ({name})"[:256]})
        seen_url[norm.lower()] = fresh[-1]
        if len(existing) + len(fresh) > MAX_ITEMS:
            print("sync would exceed bookmark limit", file=sys.stderr)
            return 1
    if dry_run:
        print(f"zen-sync dry-run [{name}]: {len(fresh)} new, {len(items)} in zen, {len(existing)} in bookomarchy")
        return 0
    if fresh:
        cmd_backup([])
        save(existing + fresh)
    settings.setdefault("zenSync", {})
    if isinstance(settings["zenSync"], dict):
        settings["zenSync"]["lastSync"] = datetime.now().strftime("%Y-%m-%d %H:%M")
        settings["zenSync"]["lastSource"] = (source or "")[:512]
        settings["zenSync"]["lastAdded"] = len(fresh)
        save_settings(settings)
    print(f"zen-sync [{name}]: imported {len(fresh)} of {len(items)}")
    return 0


def zen_source_mtime():
    settings = load_settings()
    zcfg = settings.get("zenSync") if isinstance(settings.get("zenSync"), dict) else {}
    if isinstance(zcfg, dict) and zcfg.get("enabled") is False:
        return None
    _, path = pick_zen_profile((zcfg.get("profile") if isinstance(zcfg, dict) else None) or None)
    if not path:
        return None
    mtimes = []
    for p in glob.glob(os.path.join(path, "bookmarkbackups", "*.jsonlz4")):
        try:
            mtimes.append(os.path.getmtime(p))
        except OSError:
            pass
    try:
        mtimes.append(os.path.getmtime(os.path.join(path, "places.sqlite")))
    except OSError:
        pass
    return max(mtimes) if mtimes else None


def cmd_recategorize(_args):
    """Apply category rules to existing items (backup first)."""
    existing = load()
    changed = []
    for x in existing:
        if str(x.get("type", "url")) != "url":
            continue
        want = rule_category(x.get("title", ""), x.get("target", ""), x.get("category", "General"))
        if want and want != x.get("category"):
            x["category"] = want
            changed.append(x.get("id"))
    if changed:
        cmd_backup([])
        save(existing)
    print(f"recategorized {len(changed)}: {', '.join(changed) if changed else '-'}")
    return 0


def sh(*args, cwd=None):
    return subprocess.run(args, cwd=cwd or STATE.path, capture_output=True,
                          text=True, timeout=30)


def cmd_git_sync(_args):
    if not os.path.isdir(os.path.join(STATE.path, ".git")):
        r = sh("git", "init")
        if r.returncode != 0:
            print(r.stderr.strip() or "git init failed", file=sys.stderr)
            return 1
    sh("git", "add", "bookmarks.json", "settings.json")
    r = sh("git", "diff", "--cached", "--quiet")
    if r.returncode != 0:
        stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
        sh("git", "-c", "user.name=bookomarchy", "-c", "user.email=bookomarchy@local", "commit", "-m", f"bookomarchy sync {stamp}")
    # pull/push only if a remote exists; never fail hard offline.
    rem = sh("git", "remote")
    if rem.stdout.strip():
        pull = sh("git", "pull", "--ff-only")
        push = sh("git", "push")
        print((pull.stdout + pull.stderr + push.stdout + push.stderr).strip()[-2000:] or "synced")
    else:
        print("committed locally (no git remote configured)")
    return 0


def main(argv):
    global STATE, ZEN_BASE
    scrub_env()
    home = os.path.expanduser("~")
    if not home or home == "~":
        print("cannot resolve home directory", file=sys.stderr)
        return 1
    try:
        STATE = StateFS(home)
    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 1
    ZEN_BASE = os.path.join(home, ".config", "zen")
    if len(argv) < 2:
        print("usage: backup|export-json|export-html|import|git-sync|zen-sync|recategorize|zen-source-mtime", file=sys.stderr)
        return 2
    action, rest = argv[1], argv[2:]
    signal.signal(signal.SIGALRM, on_timeout)
    signal.alarm(TIMEOUTS.get(action, DEFAULT_TIMEOUT))
    try:
        if action == "backup":
            cmd_backup(rest)
        elif action == "export-json":
            cmd_export_json(rest)
        elif action == "export-html":
            cmd_export_html(rest)
        elif action == "import":
            return cmd_import(rest)
        elif action == "git-sync":
            return cmd_git_sync(rest)
        elif action == "zen-sync":
            return cmd_zen_sync(rest)
        elif action == "recategorize":
            return cmd_recategorize(rest)
        elif action == "zen-source-mtime":
            m = zen_source_mtime()
            print(int(m) if m else 0)
        else:
            print(f"unknown action: {action}", file=sys.stderr)
            return 2
        return 0
    finally:
        signal.alarm(0)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
