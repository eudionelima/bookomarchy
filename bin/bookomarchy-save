#!/usr/bin/python3
"""Atomic stdin -> bookmarks.json writer. No argv user data, no shell.

Hardening (marketplace security baseline):
- Fixed interpreter (/usr/bin/python3) + clean allowlist env (see Menu.qml,
  which spawns helpers via `env -i`). Env is scrubbed again here.
- Hard wall-clock timeout via SIGALRM.
- State dir verified symlink-free (nofollow), mode 0700, owned by our uid.
- Bounded stdin / entry counts / field lengths / output size.
- Unpredictable O_EXCL tmp file + fsync + atomic os.replace + dir fsync.
"""
import json
import os
import signal
import stat
import sys
import tempfile

TIMEOUT_S = 15
MAX_STDIN = 8 * 1024 * 1024
MAX_ITEMS = 20000
MAX_OUTPUT = 8 * 1024 * 1024
FIELD_LIMITS = {"id": 128, "title": 512, "target": 2048, "type": 32,
                "category": 128, "description": 2048}
LIST_LIMITS = {"aliases": 32, "tags": 32}

REQUIRED = ("id", "title", "target")
SCRUB_ENV = ("LD_PRELOAD", "LD_LIBRARY_PATH", "LD_AUDIT", "PYTHONPATH",
             "PYTHONHOME", "PYTHONSTARTUP", "BASH_ENV", "ENV", "ZDOTDIR",
             "PERL5LIB", "RUBYLIB", "NODE_PATH")


def scrub_env():
    for k in SCRUB_ENV:
        os.environ.pop(k, None)


def on_timeout(_signum, _frame):
    print("timed out", file=sys.stderr)
    os._exit(124)


def secure_home():
    home = os.path.expanduser("~")
    if not home or home == "~" or not os.path.isdir(home):
        raise RuntimeError("cannot resolve home directory")
    return home


def secure_state_dir(path):
    """Create/verify private nofollow state dir. Rejects symlinked components."""
    home = secure_home()
    real_home = os.path.realpath(home)
    if os.path.abspath(path) != os.path.abspath(
            os.path.join(home, ".config", "omarchy", "bookomarchy")):
        raise RuntimeError("unexpected state dir")
    # Nofollow walk from home down: every component must exist as a real dir
    # (or be created by us) and must not be a symlink.
    rel = os.path.relpath(path, home)
    cur = home
    for part in rel.split(os.sep):
        if part in ("", ".", ".."):
            raise RuntimeError("bad path component")
        cur = os.path.join(cur, part)
        try:
            st = os.lstat(cur)
            if stat.S_ISLNK(st.st_mode):
                raise RuntimeError(f"refusing symlinked component: {cur}")
            if not stat.S_ISDIR(st.st_mode):
                raise RuntimeError(f"not a directory: {cur}")
        except FileNotFoundError:
            os.mkdir(cur, 0o700)
    os.chmod(path, 0o700)
    st = os.stat(path)
    if st.st_uid != os.getuid():
        raise RuntimeError("state dir not owned by current user")
    if os.path.realpath(path) != os.path.abspath(path):
        raise RuntimeError("state dir resolves outside itself")
    return path


def read_stdin_bounded():
    buf = sys.stdin.buffer.read(MAX_STDIN + 1)
    if len(buf) > MAX_STDIN:
        raise RuntimeError("stdin exceeds size limit")
    return buf.decode("utf-8")


def check_entry(it):
    if not isinstance(it, dict):
        raise RuntimeError("each bookmark must be an object")
    for k in REQUIRED:
        if not str(it.get(k, "")).strip():
            raise RuntimeError(f"missing required field: {k}")
    for banned in ("password", "token", "private_key", "secret"):
        if banned in it:
            raise RuntimeError(f"refused field: {banned}")
    for field, limit in FIELD_LIMITS.items():
        v = it.get(field)
        if v is not None and len(str(v)) > limit:
            raise RuntimeError(f"field too long: {field}")
    for field, limit in LIST_LIMITS.items():
        v = it.get(field)
        if v is not None:
            if not isinstance(v, list) or len(v) > limit:
                raise RuntimeError(f"bad list field: {field}")
            for e in v:
                if len(str(e)) > 128:
                    raise RuntimeError(f"list entry too long: {field}")


def atomic_write(dest, payload: bytes):
    if len(payload) > MAX_OUTPUT:
        raise RuntimeError("output exceeds size limit")
    d = os.path.dirname(dest)
    fd, tmp = tempfile.mkstemp(prefix=".bookmarks-", suffix=".tmp", dir=d)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(payload)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, dest)
        tmp = None
    finally:
        if tmp is not None:
            try:
                os.unlink(tmp)
            except OSError:
                pass
    dirfd = os.open(d, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(dirfd)
    finally:
        os.close(dirfd)


def main() -> int:
    scrub_env()
    signal.signal(signal.SIGALRM, on_timeout)
    signal.alarm(TIMEOUT_S)
    try:
        home = secure_home()
        data_dir = secure_state_dir(
            os.path.join(home, ".config", "omarchy", "bookomarchy"))
        dest = os.path.join(data_dir, "bookmarks.json")
        raw = read_stdin_bounded()
        try:
            data = json.loads(raw)
        except Exception as e:
            print(f"invalid JSON: {e}", file=sys.stderr)
            return 1
        items = data if isinstance(data, list) else data.get("bookmarks", [])
        if not isinstance(items, list):
            print("bookmarks must be a list", file=sys.stderr)
            return 1
        if len(items) > MAX_ITEMS:
            print("too many bookmarks", file=sys.stderr)
            return 1
        for it in items:
            try:
                check_entry(it)
            except RuntimeError as e:
                print(str(e), file=sys.stderr)
                return 1
        payload = (json.dumps(items, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
        try:
            atomic_write(dest, payload)
        except RuntimeError as e:
            print(str(e), file=sys.stderr)
            return 1
        print(f"saved {len(items)} bookmarks")
        return 0
    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 1
    finally:
        signal.alarm(0)


if __name__ == "__main__":
    raise SystemExit(main())
