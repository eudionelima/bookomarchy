#!/usr/bin/python3
"""Atomic stdin -> bookmarks.json writer. No argv user data, no shell.

Hardening (marketplace security baseline):
- Fixed interpreter (/usr/bin/python3) + clean allowlist env: spawned from
  QML with clearEnvironment + `env -i`. Env scrubbed again here.
- Hard wall-clock timeout via SIGALRM.
- State dir opened once per component with O_DIRECTORY|O_NOFOLLOW and the
  verified leaf fd is RETAINED: every read, exclusive temp creation, fsync
  and renameat is dirfd-relative, so a path component swapped between
  check and use cannot redirect IO (no TOCTOU). Unpredictable tmp names
  protect the leaf; parent identity comes from the held fd.
- Leaf dir mode 0700 + uid-owned (fstat, never path-resolved twice).
- Bounded stdin / entry counts / field lengths / output size.
"""
import json
import os
import secrets
import signal
import stat
import sys

TIMEOUT_S = 15
MAX_STDIN = 8 * 1024 * 1024
MAX_ITEMS = 20000
MAX_OUTPUT = 8 * 1024 * 1024
FIELD_LIMITS = {"id": 128, "title": 512, "target": 2048, "type": 32,
                "category": 128, "description": 2048}
LIST_LIMITS = {"aliases": 32, "tags": 32}

REQUIRED = ("id", "title", "target")
SCRUB_ENV = ("LD_PRELOAD", "LD_LIBRARY_PATH", "LD_AUDIT", "PYTHONPATH",
             "PYTHONHOME", "PYTHONSTARTUP", "BASH_ENV", "ENV", "ZDOTDIR",
             "PERL5LIB", "RUBYLIB", "NODE_PATH")


def scrub_env():
    for k in SCRUB_ENV:
        os.environ.pop(k, None)


def on_timeout(_signum, _frame):
    print("timed out", file=sys.stderr)
    os._exit(124)


def _leaf_ok(name):
    return bool(name) and "/" not in name and name not in (".", "..") \
        and not name.startswith(".") and len(name) <= 128


class StateFS:
    """Verified state dir held by fd; all IO dirfd-relative (no TOCTOU)."""

    def __init__(self, home):
        base = os.path.realpath(home)
        if not base or not os.path.isdir(base):
            raise RuntimeError("cannot resolve home directory")
        fd = os.open(base, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        try:
            for part in (".config", "omarchy", "bookomarchy"):
                fd = self._child(fd, part, create=True, close_parent=True,
                                 strict=False)
            self._verify(fd, "state dir", strict=True)
            self.fd = fd
        except BaseException:
            try:
                os.close(fd)
            except OSError:
                pass
            raise

    @staticmethod
    def _verify(fd, what, strict):
        st = os.fstat(fd)
        if not stat.S_ISDIR(st.st_mode):
            raise RuntimeError(f"{what} is not a directory")
        if st.st_uid != os.getuid():
            raise RuntimeError(f"{what} not owned by current user")
        if strict and stat.S_IMODE(st.st_mode) & 0o077:
            os.fchmod(fd, 0o700)

    def _child(self, parent_fd, name, create, close_parent, strict):
        if not _leaf_ok(name) and name not in (".config", "omarchy", "bookomarchy"):
            raise RuntimeError(f"bad name: {name}")
        try:
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                         dir_fd=parent_fd)
        except FileNotFoundError:
            if not create:
                raise
            os.mkdir(name, 0o700, dir_fd=parent_fd)
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                         dir_fd=parent_fd)
        if close_parent:
            try:
                os.close(parent_fd)
            except OSError:
                pass
        self._verify(fd, name, strict)
        return fd

    def write_atomic(self, name, payload: bytes):
        if not _leaf_ok(name):
            raise RuntimeError(f"bad name: {name}")
        if len(payload) > MAX_OUTPUT:
            raise RuntimeError("output exceeds size limit")
        for _ in range(5):
            tmp = f".w-{secrets.token_hex(16)}.tmp"
            try:
                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL
                             | os.O_NOFOLLOW, 0o600, dir_fd=self.fd)
                break
            except FileExistsError:
                continue
        else:
            raise RuntimeError("cannot allocate temp file")
        try:
            view = memoryview(payload)
            while view:
                n = os.write(fd, view)
                view = view[n:]
            os.fsync(fd)
        finally:
            os.close(fd)
        try:
            os.rename(tmp, name, src_dir_fd=self.fd, dst_dir_fd=self.fd)
        except BaseException:
            try:
                os.unlink(tmp, dir_fd=self.fd)
            except OSError:
                pass
            raise
        os.fsync(self.fd)


def read_stdin_bounded():
    buf = sys.stdin.buffer.read(MAX_STDIN + 1)
    if len(buf) > MAX_STDIN:
        raise RuntimeError("stdin exceeds size limit")
    return buf.decode("utf-8")


def check_entry(it):
    if not isinstance(it, dict):
        raise RuntimeError("each bookmark must be an object")
    for k in REQUIRED:
        if not str(it.get(k, "")).strip():
            raise RuntimeError(f"missing required field: {k}")
    for banned in ("password", "token", "private_key", "secret"):
        if banned in it:
            raise RuntimeError(f"refused field: {banned}")
    for field, limit in FIELD_LIMITS.items():
        v = it.get(field)
        if v is not None and len(str(v)) > limit:
            raise RuntimeError(f"field too long: {field}")
    for field, limit in LIST_LIMITS.items():
        v = it.get(field)
        if v is not None:
            if not isinstance(v, list) or len(v) > limit:
                raise RuntimeError(f"bad list field: {field}")
            for e in v:
                if len(str(e)) > 128:
                    raise RuntimeError(f"list entry too long: {field}")


def main() -> int:
    scrub_env()
    signal.signal(signal.SIGALRM, on_timeout)
    signal.alarm(TIMEOUT_S)
    try:
        home = os.path.expanduser("~")
        if not home or home == "~":
            print("cannot resolve home directory", file=sys.stderr)
            return 1
        state = StateFS(home)
        raw = read_stdin_bounded()
        try:
            data = json.loads(raw)
        except Exception as e:
            print(f"invalid JSON: {e}", file=sys.stderr)
            return 1
        items = data if isinstance(data, list) else data.get("bookmarks", [])
        if not isinstance(items, list):
            print("bookmarks must be a list", file=sys.stderr)
            return 1
        if len(items) > MAX_ITEMS:
            print("too many bookmarks", file=sys.stderr)
            return 1
        for it in items:
            try:
                check_entry(it)
            except RuntimeError as e:
                print(str(e), file=sys.stderr)
                return 1
        payload = (json.dumps(items, ensure_ascii=False, indent=2) + "\n").encode("utf-8")
        try:
            state.write_atomic("bookmarks.json", payload)
        except RuntimeError as e:
            print(str(e), file=sys.stderr)
            return 1
        print(f"saved {len(items)} bookmarks")
        return 0
    except RuntimeError as e:
        print(str(e), file=sys.stderr)
        return 1
    finally:
        signal.alarm(0)


if __name__ == "__main__":
    raise SystemExit(main())
